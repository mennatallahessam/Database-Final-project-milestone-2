# ==============================================================================
# Milestone 3 - Database Connection Configuration (Remote Host)
# Note: DB_HOST MUST be a remote host (e.g. db4free.net, aiven, etc.)
# Localhost / 127.0.0.1 is rejected by startup security guard.
# ==============================================================================
DB_HOST=db4free.net
DB_PORT=3306
DB_USER=your_remote_db_user
DB_PASSWORD=your_remote_db_password
DB_NAME=your_remote_db_name
DB_SSL=false
APP_SECRET=replace_with_a_secure_session_secret_for_flask

# Flask Application Settings
FLASK_PORT=5000
FLASK_DEBUG=false
